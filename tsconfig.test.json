{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": ".codex-temp/test-build",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "src/api/apiClient.ts",
    "src/api/index.ts",
    "src/vite-env.d.ts",
    "src/features/auth/types.ts",
    "src/features/auth/utils/authStorage.ts",
    "src/features/management/api/index.ts",
    "src/features/management/api/servicesApi.ts",
    "src/features/management/api/createServiceApi.ts",
    "src/features/management/api/updateServiceApi.ts",
    "src/features/management/hooks/services/useServicePagination.ts",
    "src/features/management/hooks/services/useServicesList.ts",
    "src/features/management/types.ts",
    "src/features/order/api/index.ts",
    "src/features/order/api/boothRequestDetailsApi.ts",
    "src/features/order/api/boothRequestStatisticsApi.ts",
    "src/features/order/api/boothRequestsApi.ts",
    "src/features/order/components/orderTableColumns.tsx",
    "src/features/order/data/orderSummaryStatistics.ts",
    "src/features/order/hooks/useBoothRequestFilters.ts",
    "src/features/order/hooks/useBoothRequestDetails.ts",
    "src/features/order/hooks/useBoothRequestStatistics.ts",
    "src/features/order/hooks/useBoothRequests.ts",
    "src/features/order/types.ts",
    "src/features/visitor/api/index.ts",
    "src/features/visitor/api/visitorStatisticsApi.ts",
    "src/features/visitor/api/visitorsApi.ts",
    "src/features/visitor/hooks/useVisitorFilters.ts",
    "src/features/visitor/hooks/useVisitorStatistics.ts",
    "src/features/visitor/hooks/useVisitors.ts",
    "src/features/visitor/types.ts",
    "tests/**/*.test.ts",
    "tests/**/*.test.tsx"
  ]
}
